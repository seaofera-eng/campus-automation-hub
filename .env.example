# =============================================================================
# 캠퍼스 자동화 관제 플랫폼 — 환경변수 예시
# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요. 실제 비밀값은 커밋하지 않습니다.
# =============================================================================

# -----------------------------------------------------------------------------
# 실행 모드
# -----------------------------------------------------------------------------
# true  : DEMO 모드. Supabase 없이 로컬 파일(.data/demo-db.json)로 동작합니다.
#         모든 데이터는 가상 데이터이며 화면 상단에 DEMO 배너가 표시됩니다.
# false : Supabase 연결 모드. 아래 SUPABASE_* 값이 모두 필요합니다.
NEXT_PUBLIC_DEMO_MODE=true

# 앱 기본 URL (절대경로 링크·리다이렉트에 사용)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# DEMO 모드 설정
# -----------------------------------------------------------------------------
# 데모 세션 쿠키 서명용 키. 32자 이상 임의 문자열.
# 데모 전용이며 운영 인증에는 사용하지 않습니다.
DEMO_SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars

# 데모 데이터 저장 경로 (기본값: <프로젝트 루트>/.data)
# DEMO_DATA_DIR=.data

# -----------------------------------------------------------------------------
# Supabase (NEXT_PUBLIC_DEMO_MODE=false 일 때만 필요)
# -----------------------------------------------------------------------------
# 브라우저에 노출되는 값 — anon key 는 RLS 로 보호됩니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# !! 서버 전용 !! 절대로 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
# 이 키는 RLS를 우회하므로 클라이언트 번들에 포함되면 안 됩니다.
SUPABASE_SERVICE_ROLE_KEY=

# Storage 버킷명 (도구 첨부자료)
SUPABASE_STORAGE_BUCKET=tool-attachments

# -----------------------------------------------------------------------------
# 2단계 이후 예정 (지금은 사용하지 않습니다 — 비워 두세요)
# 이 값들이 설정되어 있어도 1단계 코드는 외부 API를 호출하지 않습니다.
# -----------------------------------------------------------------------------
# ANTHROPIC_API_KEY=
# AI_DUPLICATE_DETECTION_ENABLED=false
# AI_RISK_ASSESSMENT_ENABLED=false
# AI_DEMAND_MATCHING_ENABLED=false
# AI_MULTI_LLM_REVIEW_ENABLED=false
